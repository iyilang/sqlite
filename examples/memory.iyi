# crystal-sqlite3's samples/memory.cr: an in-memory database, queried with
# positional and `args:` arguments.
module examples/memory

import db
import db/db/errors::{DBError}
import db/db/value::{DBValue}
import sqlite

def run : Nil | DBError
  Db.open("sqlite3://%3Amemory%3A") do |db|
    db.exec("create table contacts (name text, age integer)")!
    db.exec("insert into contacts values (?, ?)", "John Doe", 30)!

    args = [] of DBValue
    args << "Sarah"
    args << 33
    db.exec("insert into contacts values (?, ?)", args: args)!

    puts "max age:"
    puts db.scalar("select max(age) from contacts")! # => 33

    puts "contacts:"
    db.query("select name, age from contacts order by age desc") do |rs|
      puts "#{rs.column_name(0)} (#{rs.column_name(1)})"
      # => name (age)
      rs.each do
        puts "#{rs.read(String)!} (#{rs.read(Int32)!})"
        # => Sarah (33)
        # => John Doe (30)
      end!
    end!
  end
end

case run
in Nil     then nil
in DBError then puts "failed: #{it.message}"
end
