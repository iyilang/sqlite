# The SQLite3 driver for iyi-db: a port of crystal-sqlite3
# (https://github.com/crystal-lang/crystal-sqlite3) 0.24.0, written in iyi.
#
# Importing this module registers the driver for `sqlite3:` URIs:
#
# ```
# import db/db/db
# import sqlite/sqlite/sqlite
#
# Db::Db.open("sqlite3:./data.db") do |db|
#   puts db.scalar("select sqlite_version()")!
# end
# ```
module sqlite/sqlite

pub import sqlite/core
pub import sqlite/dates
pub import sqlite/errors

import db/db/value

pub VERSION = "0.1.0"

# The values this driver binds as arguments and reads back: iyi-db's `Any`
# and the narrower integers. crystal-sqlite3's `SQLite3::Any`.
pub alias Any = ::Db::Value::Any | Int16 | Int8 | UInt32 | UInt16 | UInt8
