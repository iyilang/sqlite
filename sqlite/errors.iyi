# What a failed SQLite call answers: crystal-sqlite3's `SQLite3::Exception`,
# a `DBError` here (SPEC.md III.1).
module sqlite/errors

import db/db/errors::{DBError}

# An invalid SQLite3 operation: SQLite's message for it and its result codes.
pub class SQLite3Error < DBError
  # The primary result code of the failure (`sqlite3_errcode`), such as
  # `SQLITE_CONSTRAINT` (19).
  getter code : Int32
  # The extended result code (`sqlite3_extended_errcode`), which says which
  # kind of the primary code it is, such as `SQLITE_CONSTRAINT_UNIQUE`
  # (2067). Its low eight bits are `code`.
  getter extended_code : Int32

  def initialize(message : String, @code : Int32, @extended_code : Int32)
    super(message)
  end
end
